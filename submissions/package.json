{
  "name": "fueledby-submissions",
  "version": "0.1.0",
  "private": true,
  "description": "Plugin submissions from the fueledby Hub: uploads to R2, metadata in D1, a review queue (nothing auto-publishes)",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply fueledby-submissions --local",
    "db:migrate:remote": "wrangler d1 migrations apply fueledby-submissions --remote",
    "review": "node scripts/review.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251014.0",
    "@types/node": "^22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.42.2"
  }
}
